---
import Base from "../../layouts/Base.astro";

const sides = [
  { key: "front", title: "Front side", dropTitle: "Drop the front side", order: "Side 1" },
  { key: "back", title: "Back side", dropTitle: "Drop the back side", order: "Side 2" },
];
const handles = ["nw", "n", "ne", "e", "se", "s", "sw", "w"];
---

<Base
  title="NID Merge & Crop — Mutation Automation"
  description="Straighten, crop, and merge the front and back of a Bangladesh NID into one white A4 PDF or image. Private, on-device processing."
>
  <header class="nav">
    <div class="container nav-inner">
      <a class="brand" href="/"><span class="brand-mark">M</span> Mutation Automation</a>
      <nav class="nav-links" aria-label="Main navigation">
        <a href="/#product">Product</a>
        <a href="/tools" aria-current="page">Tools</a>
        <a href="/#bugs">Bug map</a>
        <a href="/#how">How it works</a>
        <a href="/#experience">Experience</a>
        <a href="/#contact">Contact</a>
      </nav>
      <a class="btn btn-sm-glass" href="/tools">← All tools</a>
    </div>
  </header>

  <main>
    <section class="tool-page">
      <div class="container tool-container">
        <a class="back-link" href="/tools">← Document tools</a>
        <div class="section-head" style="margin:24px 0 32px">
          <div class="eyebrow">Private · on-device processing</div>
          <h1 class="display-md">Two sides. One clean NID.</h1>
          <p class="body-lg">Add the front and back of the NID, straighten and crop each side, then download a single A4 PDF or image on a white sheet.</p>
        </div>

        <div class="merge-grid">
          {sides.map((side) => (
            <article class="card nid-side" data-side={side.key}>
              <div class="nid-side-head">
                <div>
                  <span class="pill pill-warn">{side.order}</span>
                  <h2>{side.title}</h2>
                </div>
                <button class="btn btn-sm-glass side-replace" type="button" hidden>Replace</button>
              </div>

              <input
                id={`${side.key}-input`}
                class="side-input"
                type="file"
                accept="image/jpeg,image/png,image/webp"
                hidden
              />
              <label id={`${side.key}-drop`} class="drop-zone side-drop" for={`${side.key}-input`}>
                <span class="upload-icon" aria-hidden="true">↑</span>
                <strong>{side.dropTitle}</strong>
                <span>or click to choose a file</span>
                <small>JPG, PNG or WebP · up to 10 MB</small>
              </label>

              <div class="crop-editor" hidden>
                <div class="crop-stage">
                  <div class="crop-frame">
                    <canvas class="crop-canvas" role="img" aria-label={`${side.title} preview`}></canvas>
                    <div class="crop-box" tabindex="0" role="group" aria-label={`Crop area for the ${side.title.toLowerCase()}`}>
                      {handles.map((handle) => (
                        <span class="crop-handle" data-handle={handle} aria-hidden="true"></span>
                      ))}
                    </div>
                  </div>
                </div>
                <div class="crop-tools">
                  <button class="btn btn-sm-glass auto-crop" type="button" data-action="auto">Auto crop</button>
                  <button class="btn btn-sm-glass" type="button" data-action="left" aria-label={`Rotate the ${side.title.toLowerCase()} 90 degrees left`}>↺ Left</button>
                  <button class="btn btn-sm-glass" type="button" data-action="right" aria-label={`Rotate the ${side.title.toLowerCase()} 90 degrees right`}>↻ Right</button>
                  <button class="btn btn-sm-glass" type="button" data-action="flip" aria-label={`Flip the ${side.title.toLowerCase()} horizontally`}>⇋ Flip</button>
                  <button class="btn btn-sm-glass" type="button" data-action="reset">Reset crop</button>
                </div>
                <div class="straighten-row">
                  <label for={`${side.key}-angle`}>Straighten</label>
                  <input id={`${side.key}-angle`} class="angle-slider" type="range" min="-20" max="20" step="0.1" value="0" />
                  <output class="angle-value code" for={`${side.key}-angle`}>0.0°</output>
                </div>
                <div class="side-meta code">
                  <span class="side-name"></span>
                  <span class="side-dims"></span>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="merge-actions">
          <button id="combine" class="btn btn-filled" type="button" disabled>Combine sides →</button>
          <p class="merge-actions-note code">Front above back · 12 mm gap · A4 sheet</p>
        </div>

        <p class="body-md muted merge-hint">Auto crop finds the card's edges and deskews it; then drag the box to fine-tune. Click Combine to build the sheet, then download it as PDF or JPG.</p>

        <div id="status" class="tool-message" role="status" aria-live="polite" hidden></div>

        <div id="output-panel" class="card merge-output" hidden>
          <div class="merge-output-grid">
            <div class="merge-preview-wrap">
              <img id="merge-preview" alt="Combined NID preview" />
            </div>
            <div class="merge-output-info">
              <span class="pill pill-ok">Live preview</span>
              <h2>A4 NID sheet</h2>
              <p id="output-copy">White A4 page with the front above the back and a 12 mm gap.</p>
              <div class="result-meta code"><span id="output-dims">—</span><span id="output-size">—</span><span>A4 · JPEG</span></div>
              <div class="result-buttons">
                <button id="download-pdf" class="btn btn-filled" type="button">Download PDF (A4) ↓</button>
                <a id="download" class="btn btn-sm-glass" download>JPG ↓</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container foot-grid">
      <div>
        <a class="brand" href="/"><span class="brand-mark">M</span> Mutation Automation</a>
        <br /><small>Document utilities for namjari filing.<br />Processed locally. Never uploaded.</small>
      </div>
      <div class="foot-links"><a href="/tools">All tools</a><a href="/#contact">Contact</a></div>
    </div>
  </footer>

  <script>
    import { jsPDF } from "jspdf";

    type SideKey = "front" | "back";
    type Crop = { x: number; y: number; w: number; h: number };
    type Handle = "move" | "n" | "s" | "e" | "w" | "ne" | "nw" | "se" | "sw";
    type Point = { x: number; y: number };
    type DetectRect = { cx: number; cy: number; width: number; height: number; angle: number };
    type Side = {
      key: SideKey;
      root: HTMLElement;
      input: HTMLInputElement;
      drop: HTMLLabelElement;
      editor: HTMLDivElement;
      canvas: HTMLCanvasElement;
      box: HTMLDivElement;
      replace: HTMLButtonElement;
      nameLabel: HTMLElement;
      dimsLabel: HTMLElement;
      angleSlider: HTMLInputElement;
      angleValue: HTMLOutputElement;
      image: HTMLImageElement | null;
      oriented: HTMLCanvasElement | null;
      rotation: number;
      angle: number;
      flipped: boolean;
      crop: Crop;
    };

    const allowedTypes = new Set(["image/jpeg", "image/png", "image/webp"]);
    const maxFileBytes = 10 * 1024 * 1024;
    const minCrop = 0.06;
    const previewWidth = 1200;
    const a4 = { width: 210, height: 297, margin: 20, gap: 12, minVertical: 16 };
    const status = document.querySelector<HTMLDivElement>("#status")!;
    const outputPanel = document.querySelector<HTMLDivElement>("#output-panel")!;
    const outputCopy = document.querySelector<HTMLElement>("#output-copy")!;
    const outputDims = document.querySelector<HTMLElement>("#output-dims")!;
    const outputSize = document.querySelector<HTMLElement>("#output-size")!;
    const preview = document.querySelector<HTMLImageElement>("#merge-preview")!;
    const downloadLink = document.querySelector<HTMLAnchorElement>("#download")!;
    const downloadPdf = document.querySelector<HTMLButtonElement>("#download-pdf")!;
    const combineButton = document.querySelector<HTMLButtonElement>("#combine")!;
    const sides = {
      front: createSide("front"),
      back: createSide("back"),
    } as Record<SideKey, Side>;
    let outputUrl = "";
    let outputVisible = false;
    let composeSequence = 0;
    let composeTimer = 0;

    function clamp(value: number, min: number, max: number) {
      return Math.min(max, Math.max(min, value));
    }

    function showStatus(message: string, isError = false) {
      status.textContent = message;
      status.hidden = false;
      status.classList.toggle("tool-message-error", isError);
      status.setAttribute("role", isError ? "alert" : "status");
    }

    function hideStatus() {
      status.hidden = true;
    }

    function createSide(key: SideKey): Side {
      const root = document.querySelector<HTMLElement>(`.nid-side[data-side="${key}"]`)!;
      return {
        key,
        root,
        input: root.querySelector<HTMLInputElement>(".side-input")!,
        drop: root.querySelector<HTMLLabelElement>(".side-drop")!,
        editor: root.querySelector<HTMLDivElement>(".crop-editor")!,
        canvas: root.querySelector<HTMLCanvasElement>(".crop-canvas")!,
        box: root.querySelector<HTMLDivElement>(".crop-box")!,
        replace: root.querySelector<HTMLButtonElement>(".side-replace")!,
        nameLabel: root.querySelector<HTMLElement>(".side-name")!,
        dimsLabel: root.querySelector<HTMLElement>(".side-dims")!,
        angleSlider: root.querySelector<HTMLInputElement>(".angle-slider")!,
        angleValue: root.querySelector<HTMLOutputElement>(".angle-value")!,
        image: null,
        oriented: null,
        rotation: 0,
        angle: 0,
        flipped: false,
        crop: { x: 0, y: 0, w: 1, h: 1 },
      };
    }

    function loadImage(file: File) {
      return new Promise<HTMLImageElement>((resolve, reject) => {
        const url = URL.createObjectURL(file);
        const image = new Image();
        image.onload = () => { URL.revokeObjectURL(url); resolve(image); };
        image.onerror = () => { URL.revokeObjectURL(url); reject(new Error("That image could not be read.")); };
        image.src = url;
      });
    }

    function orientedCanvas(image: HTMLImageElement, rotation: number, angle: number, flipped: boolean) {
      const swap = rotation % 180 !== 0;
      const baseWidth = swap ? image.naturalHeight : image.naturalWidth;
      const baseHeight = swap ? image.naturalWidth : image.naturalHeight;
      const radians = (angle * Math.PI) / 180;
      const width = Math.ceil(baseWidth * Math.abs(Math.cos(radians)) + baseHeight * Math.abs(Math.sin(radians)));
      const height = Math.ceil(baseWidth * Math.abs(Math.sin(radians)) + baseHeight * Math.abs(Math.cos(radians)));
      const canvas = document.createElement("canvas");
      canvas.width = width;
      canvas.height = height;
      const context = canvas.getContext("2d")!;
      context.fillStyle = "#ffffff";
      context.fillRect(0, 0, width, height);
      context.translate(width / 2, height / 2);
      context.rotate(((rotation + angle) * Math.PI) / 180);
      if (flipped) context.scale(-1, 1);
      context.drawImage(image, -image.naturalWidth / 2, -image.naturalHeight / 2);
      return canvas;
    }

    const detectSize = 560;

    function grayFromImage(image: HTMLImageElement) {
      const scale = Math.min(1, detectSize / Math.max(image.naturalWidth, image.naturalHeight));
      const width = Math.max(1, Math.round(image.naturalWidth * scale));
      const height = Math.max(1, Math.round(image.naturalHeight * scale));
      const canvas = document.createElement("canvas");
      canvas.width = width;
      canvas.height = height;
      const context = canvas.getContext("2d", { willReadFrequently: true })!;
      context.drawImage(image, 0, 0, width, height);
      const data = context.getImageData(0, 0, width, height).data;
      const luma = new Uint8Array(width * height);
      for (let i = 0, p = 0; i < luma.length; i++, p += 4) {
        luma[i] = (data[p] * 299 + data[p + 1] * 587 + data[p + 2] * 114) / 1000;
      }
      return { width, height, luma, scale };
    }

    function edgeMap(luma: Uint8Array, width: number, height: number) {
      const magnitude = new Uint16Array(width * height);
      for (let y = 1; y < height - 1; y++) {
        for (let x = 1; x < width - 1; x++) {
          const i = y * width + x;
          const gx = luma[i - width + 1] + 2 * luma[i + 1] + luma[i + width + 1]
            - luma[i - width - 1] - 2 * luma[i - 1] - luma[i + width - 1];
          const gy = luma[i + width - 1] + 2 * luma[i + width] + luma[i + width + 1]
            - luma[i - width - 1] - 2 * luma[i - width] - luma[i - width + 1];
          magnitude[i] = Math.min(65535, Math.abs(gx) + Math.abs(gy));
        }
      }
      return magnitude;
    }

    function highPercentile(values: Uint16Array, fraction: number) {
      const sample: number[] = [];
      for (let i = 0; i < values.length; i += 7) sample.push(values[i]);
      sample.sort((a, b) => a - b);
      return sample.length ? sample[Math.min(sample.length - 1, Math.floor(sample.length * fraction))] : 0;
    }

    function otsuThreshold(luma: Uint8Array) {
      const histogram = new Uint32Array(256);
      for (let i = 0; i < luma.length; i++) histogram[luma[i]]++;
      const total = luma.length;
      let sum = 0;
      for (let i = 0; i < 256; i++) sum += i * histogram[i];
      let sumBackground = 0;
      let countBackground = 0;
      let best = 0;
      let threshold = 127;
      for (let t = 0; t < 256; t++) {
        countBackground += histogram[t];
        if (!countBackground) continue;
        const countForeground = total - countBackground;
        if (!countForeground) break;
        sumBackground += t * histogram[t];
        const meanBackground = sumBackground / countBackground;
        const meanForeground = (sum - sumBackground) / countForeground;
        const between = countBackground * countForeground * (meanBackground - meanForeground) ** 2;
        if (between > best) {
          best = between;
          threshold = t;
        }
      }
      return threshold;
    }

    function largestComponent(mask: Uint8Array, width: number, height: number) {
      const seen = new Uint8Array(mask.length);
      const stack = new Int32Array(mask.length);
      const points: number[] = [];
      let bestPoints: number[] = [];
      let bestCount = 0;
      for (let start = 0; start < mask.length; start++) {
        if (!mask[start] || seen[start]) continue;
        let top = 0;
        stack[top++] = start;
        seen[start] = 1;
        points.length = 0;
        while (top) {
          const index = stack[--top];
          points.push(index);
          const x = index % width;
          const y = (index - x) / width;
          if (x > 0 && mask[index - 1] && !seen[index - 1]) { seen[index - 1] = 1; stack[top++] = index - 1; }
          if (x + 1 < width && mask[index + 1] && !seen[index + 1]) { seen[index + 1] = 1; stack[top++] = index + 1; }
          if (y > 0 && mask[index - width] && !seen[index - width]) { seen[index - width] = 1; stack[top++] = index - width; }
          if (y + 1 < height && mask[index + width] && !seen[index + width]) { seen[index + width] = 1; stack[top++] = index + width; }
        }
        if (points.length > bestCount) {
          bestCount = points.length;
          bestPoints = points.slice();
        }
      }
      return { count: bestCount, points: bestPoints };
    }

    function samplePoints(indices: number[], width: number, step: number) {
      const points: Point[] = [];
      for (let i = 0; i < indices.length; i += step) {
        const index = indices[i];
        const x = index % width;
        points.push({ x, y: (index - x) / width });
      }
      return points;
    }

    function convexHull(points: Point[]) {
      points.sort((a, b) => a.x - b.x || a.y - b.y);
      const cross = (o: Point, a: Point, b: Point) => (a.x - o.x) * (b.y - o.y) - (a.y - o.y) * (b.x - o.x);
      const lower: Point[] = [];
      for (const point of points) {
        while (lower.length >= 2 && cross(lower[lower.length - 2], lower[lower.length - 1], point) <= 0) lower.pop();
        lower.push(point);
      }
      const upper: Point[] = [];
      for (let i = points.length - 1; i >= 0; i--) {
        const point = points[i];
        while (upper.length >= 2 && cross(upper[upper.length - 2], upper[upper.length - 1], point) <= 0) upper.pop();
        upper.push(point);
      }
      lower.pop();
      upper.pop();
      return lower.concat(upper);
    }

    function minAreaRect(hull: Point[]) {
      let best: { area: number; rect: DetectRect } | null = null;
      for (let i = 0; i < hull.length; i++) {
        const a = hull[i];
        const b = hull[(i + 1) % hull.length];
        const length = Math.hypot(b.x - a.x, b.y - a.y);
        if (length < 1e-6) continue;
        const ux = (b.x - a.x) / length;
        const uy = (b.y - a.y) / length;
        let minU = Infinity, maxU = -Infinity, minV = Infinity, maxV = -Infinity;
        for (const point of hull) {
          const u = point.x * ux + point.y * uy;
          const v = -point.x * uy + point.y * ux;
          if (u < minU) minU = u;
          if (u > maxU) maxU = u;
          if (v < minV) minV = v;
          if (v > maxV) maxV = v;
        }
        const area = (maxU - minU) * (maxV - minV);
        if (best && area >= best.area) continue;
        let width = maxU - minU;
        let height = maxV - minV;
        const cu = (minU + maxU) / 2;
        const cv = (minV + maxV) / 2;
        let angle = (Math.atan2(uy, ux) * 180) / Math.PI;
        while (angle > 45) {
          angle -= 90;
          [width, height] = [height, width];
        }
        while (angle <= -45) {
          angle += 90;
          [width, height] = [height, width];
        }
        best = {
          area,
          rect: { cx: cu * ux - cv * uy, cy: cu * uy + cv * ux, width, height, angle },
        };
      }
      return best ? best.rect : null;
    }

    function rectCorners(rect: DetectRect) {
      const radians = (rect.angle * Math.PI) / 180;
      const cos = Math.cos(radians);
      const sin = Math.sin(radians);
      const halfWidth = rect.width / 2;
      const halfHeight = rect.height / 2;
      return [
        { x: rect.cx - halfWidth * cos + halfHeight * sin, y: rect.cy - halfWidth * sin - halfHeight * cos },
        { x: rect.cx + halfWidth * cos + halfHeight * sin, y: rect.cy + halfWidth * sin - halfHeight * cos },
        { x: rect.cx + halfWidth * cos - halfHeight * sin, y: rect.cy + halfWidth * sin + halfHeight * cos },
        { x: rect.cx - halfWidth * cos - halfHeight * sin, y: rect.cy - halfWidth * sin + halfHeight * cos },
      ];
    }

    function edgeSupport(rect: DetectRect, magnitude: Uint16Array, width: number, height: number, threshold: number) {
      const corners = rectCorners(rect);
      let hits = 0;
      let samples = 0;
      for (let sideIndex = 0; sideIndex < 4; sideIndex++) {
        const from = corners[sideIndex];
        const to = corners[(sideIndex + 1) % 4];
        const steps = Math.max(8, Math.round(Math.hypot(to.x - from.x, to.y - from.y) / 4));
        for (let step = 0; step <= steps; step++) {
          const x = Math.round(from.x + (to.x - from.x) * (step / steps));
          const y = Math.round(from.y + (to.y - from.y) * (step / steps));
          samples++;
          let strongest = 0;
          for (let dy = -1; dy <= 1; dy++) {
            for (let dx = -1; dx <= 1; dx++) {
              const sx = x + dx;
              const sy = y + dy;
              if (sx < 0 || sy < 0 || sx >= width || sy >= height) continue;
              const value = magnitude[sy * width + sx];
              if (value > strongest) strongest = value;
            }
          }
          if (strongest >= threshold) hits++;
        }
      }
      return samples ? hits / samples : 0;
    }

    function perimeterScore(rect: DetectRect, magnitude: Uint16Array, width: number, height: number) {
      const corners = rectCorners(rect);
      let score = 0;
      for (let sideIndex = 0; sideIndex < 4; sideIndex++) {
        const from = corners[sideIndex];
        const to = corners[(sideIndex + 1) % 4];
        const steps = Math.max(12, Math.round(Math.hypot(to.x - from.x, to.y - from.y) / 3));
        for (let step = 0; step <= steps; step++) {
          const x = Math.round(from.x + ((to.x - from.x) * step) / steps);
          const y = Math.round(from.y + ((to.y - from.y) * step) / steps);
          if (x < 1 || y < 1 || x >= width - 1 || y >= height - 1) continue;
          score += magnitude[y * width + x];
        }
      }
      return score;
    }

    function refineAngle(rect: DetectRect, magnitude: Uint16Array, width: number, height: number) {
      let bestRect = rect;
      let bestScore = -1;
      for (let delta = -2; delta <= 2.0001; delta += 0.1) {
        const candidate = { ...rect, angle: rect.angle + delta };
        const score = perimeterScore(candidate, magnitude, width, height);
        if (score > bestScore) {
          bestScore = score;
          bestRect = candidate;
        }
      }
      return bestRect;
    }

    function refineRect(rect: DetectRect, magnitude: Uint16Array, width: number, height: number) {
      const radians = (rect.angle * Math.PI) / 180;
      const ux = Math.cos(radians);
      const uy = Math.sin(radians);
      const vx = -uy;
      const vy = ux;
      const halfWidth = rect.width / 2;
      const halfHeight = rect.height / 2;
      const reach = 8;

      const scan = (originX: number, originY: number, alongX: number, alongY: number, length: number, normalX: number, normalY: number) => {
        let bestShift = 0;
        let bestScore = -1;
        for (let shift = -reach; shift <= reach; shift++) {
          let score = 0;
          for (let i = 0; i <= 20; i++) {
            const t = -length / 2 + (length * i) / 20;
            const x = Math.round(originX + alongX * t + normalX * shift);
            const y = Math.round(originY + alongY * t + normalY * shift);
            if (x < 1 || y < 1 || x >= width - 1 || y >= height - 1) continue;
            score += magnitude[y * width + x];
          }
          if (score > bestScore) {
            bestScore = score;
            bestShift = shift;
          }
        }
        return bestShift;
      };

      const right = scan(rect.cx + ux * halfWidth, rect.cy + uy * halfWidth, vx, vy, rect.height * 0.8, ux, uy);
      const left = scan(rect.cx - ux * halfWidth, rect.cy - uy * halfWidth, vx, vy, rect.height * 0.8, -ux, -uy);
      const bottom = scan(rect.cx + vx * halfHeight, rect.cy + vy * halfHeight, ux, uy, rect.width * 0.8, vx, vy);
      const top = scan(rect.cx - vx * halfHeight, rect.cy - vy * halfHeight, ux, uy, rect.width * 0.8, -vx, -vy);

      const minU = -halfWidth - left;
      const maxU = halfWidth + right;
      const minV = -halfHeight - top;
      const maxV = halfHeight + bottom;
      const nextWidth = maxU - minU;
      const nextHeight = maxV - minV;
      if (nextWidth < rect.width * 0.7 || nextHeight < rect.height * 0.7
        || nextWidth > rect.width * 1.15 || nextHeight > rect.height * 1.15) {
        return rect;
      }
      const cu = (minU + maxU) / 2;
      const cv = (minV + maxV) / 2;
      return {
        cx: rect.cx + ux * cu + vx * cv,
        cy: rect.cy + uy * cu + vy * cv,
        width: nextWidth,
        height: nextHeight,
        angle: rect.angle,
      };
    }

    function detectCard(image: HTMLImageElement) {
      const { width, height, luma, scale } = grayFromImage(image);
      const magnitude = edgeMap(luma, width, height);
      const strongEdge = Math.max(48, highPercentile(magnitude, 0.9) * 0.5);
      const frameArea = width * height;
      const candidates: Array<{ rect: DetectRect; score: number }> = [];
      const consider = (rect: DetectRect | null, filled: number) => {
        if (!rect) return;
        const area = rect.width * rect.height;
        const fraction = area / frameArea;
        const aspect = Math.max(rect.width, rect.height) / Math.min(rect.width, rect.height);
        const support = edgeSupport(rect, magnitude, width, height, strongEdge);
        if (fraction < 0.05 || fraction > 0.97) return;
        if (aspect < 1.05 || aspect > 2.7) return;
        if (filled && filled / area < 0.7) return;
        if (support < 0.42) return;
        candidates.push({ rect, score: support * 0.75 + Math.min(1, fraction / 0.3) * 0.25 });
      };

      const threshold = otsuThreshold(luma);
      for (const invert of [false, true]) {
        const mask = new Uint8Array(frameArea);
        for (let i = 0; i < mask.length; i++) {
          const lit = luma[i] > threshold;
          mask[i] = invert ? (lit ? 0 : 1) : (lit ? 1 : 0);
        }
        const component = largestComponent(mask, width, height);
        if (component.count < frameArea * 0.04) continue;
        const points = samplePoints(component.points, width, 2);
        if (points.length < 8) continue;
        consider(minAreaRect(convexHull(points)), component.count);
      }

      const edgePixels: Point[] = [];
      const edgeCutoff = strongEdge * 1.3;
      for (let i = 0; i < magnitude.length; i += 3) {
        if (magnitude[i] < edgeCutoff) continue;
        const x = i % width;
        edgePixels.push({ x, y: (i - x) / width });
      }
      if (edgePixels.length >= 32) consider(minAreaRect(convexHull(edgePixels)), 0);

      if (!candidates.length) return null;
      const chosen = candidates.reduce((a, b) => (b.score > a.score ? b : a)).rect;
      const best = refineRect(refineAngle(chosen, magnitude, width, height), magnitude, width, height);
      const factor = 1 / scale;
      return {
        cx: best.cx * factor,
        cy: best.cy * factor,
        width: best.width * factor,
        height: best.height * factor,
        angle: best.angle,
      };
    }

    function mapImagePoint(side: Side, x: number, y: number) {
      const image = side.image!;
      const oriented = side.oriented!;
      const radians = ((side.rotation + side.angle) * Math.PI) / 180;
      const cos = Math.cos(radians);
      const sin = Math.sin(radians);
      const dx = (side.flipped ? -1 : 1) * (x - image.naturalWidth / 2);
      const dy = y - image.naturalHeight / 2;
      return {
        x: oriented.width / 2 + dx * cos - dy * sin,
        y: oriented.height / 2 + dx * sin + dy * cos,
      };
    }

    function normalizeDegrees(value: number) {
      return ((value + 180) % 360 + 360) % 360 - 180;
    }

    function autoCrop(side: Side) {
      if (!side.image) return;
      const started = performance.now();
      const detected = detectCard(side.image);
      if (!detected) {
        showStatus(`No card edge found on the ${side.key} side. Drag the crop box instead.`, true);
        return;
      }
      const desired = normalizeDegrees(side.flipped ? detected.angle : -detected.angle);
      let angle = normalizeDegrees(desired - side.rotation);
      if (angle > 90) angle -= 180;
      if (angle < -90) angle += 180;
      side.angle = clamp(Number(angle.toFixed(1)), -20, 20);
      side.angleSlider.value = side.angle.toFixed(1);
      side.angleValue.textContent = `${side.angle.toFixed(1)}°`;
      renderSide(side);

      const oriented = side.oriented!;
      const corners = rectCorners(detected).map((point) => mapImagePoint(side, point.x, point.y));
      const pad = 0;
      const minX = Math.min(...corners.map((point) => point.x));
      const maxX = Math.max(...corners.map((point) => point.x));
      const minY = Math.min(...corners.map((point) => point.y));
      const maxY = Math.max(...corners.map((point) => point.y));
      const x = clamp(minX / oriented.width - pad, 0, 1 - minCrop);
      const y = clamp(minY / oriented.height - pad, 0, 1 - minCrop);
      const w = clamp((maxX - minX) / oriented.width + pad * 2, minCrop, 1 - x);
      const h = clamp((maxY - minY) / oriented.height + pad * 2, minCrop, 1 - y);
      side.crop = trimFringe(oriented, { x, y, w, h });
      paintCrop(side);
      scheduleCompose();
      showStatus(`Card detected on the ${side.key} side in ${Math.round(performance.now() - started)} ms. Fine-tune the box if needed.`);
    }

    function trimFringe(canvas: HTMLCanvasElement, crop: Crop) {
      const context = canvas.getContext("2d", { willReadFrequently: true });
      if (!context) return crop;
      let x = Math.round(crop.x * canvas.width);
      let y = Math.round(crop.y * canvas.height);
      let w = Math.round(crop.w * canvas.width);
      let h = Math.round(crop.h * canvas.height);
      const margin = 4;
      const limit = 12;
      const readX = Math.max(0, x - margin);
      const readY = Math.max(0, y - margin);
      const readW = Math.min(canvas.width - readX, w + margin * 2);
      const readH = Math.min(canvas.height - readY, h + margin * 2);
      if (readW < 8 || readH < 8) return crop;
      const data = context.getImageData(readX, readY, readW, readH).data;

      const lineMean = (startX: number, startY: number, alongX: boolean, length: number) => {
        let red = 0, green = 0, blue = 0, count = 0;
        for (let i = Math.round(length * 0.08); i < Math.round(length * 0.92); i++) {
          const sx = alongX ? startX + i : startX;
          const sy = alongX ? startY : startY + i;
          const lx = sx - readX;
          const ly = sy - readY;
          if (lx < 0 || ly < 0 || lx >= readW || ly >= readH) continue;
          const index = (ly * readW + lx) * 4;
          red += data[index];
          green += data[index + 1];
          blue += data[index + 2];
          count++;
        }
        return count ? [red / count, green / count, blue / count] : null;
      };

      const distance = (a: number[], b: number[]) => Math.abs(a[0] - b[0]) + Math.abs(a[1] - b[1]) + Math.abs(a[2] - b[2]);

      const findTrim = (outside: number[] | null, inward: (depth: number) => number[] | null) => {
        if (!outside) return 0;
        for (let depth = 0; depth <= limit; depth++) {
          const here = inward(depth);
          const ahead = inward(depth + 2);
          const further = inward(depth + 4);
          if (!here || !ahead || !further) return depth;
          if (distance(outside, here) > 60 && distance(here, ahead) < 18 && distance(here, further) < 26) return depth;
        }
        return 0;
      };

      if (x - 3 >= 0) {
        const depth = findTrim(lineMean(x - 3, y, false, h), (d) => lineMean(x + d, y, false, h));
        x += depth;
        w -= depth;
      }
      if (x + w + 3 <= canvas.width) {
        const depth = findTrim(lineMean(x + w + 3, y, false, h), (d) => lineMean(x + w - 1 - d, y, false, h));
        w -= depth;
      }
      if (y - 3 >= 0) {
        const depth = findTrim(lineMean(x, y - 3, true, w), (d) => lineMean(x, y + d, true, w));
        y += depth;
        h -= depth;
      }
      if (y + h + 3 <= canvas.height) {
        const depth = findTrim(lineMean(x, y + h + 3, true, w), (d) => lineMean(x, y + h - 1 - d, true, w));
        h -= depth;
      }
      if (w < 32 || h < 32) return crop;
      return {
        x: clamp(x / canvas.width, 0, 1),
        y: clamp(y / canvas.height, 0, 1),
        w: clamp(w / canvas.width, minCrop, 1),
        h: clamp(h / canvas.height, minCrop, 1),
      };
    }

    function fitFrame(side: Side) {
      if (!side.oriented) return;
      const stage = side.canvas.closest<HTMLElement>(".crop-stage")!;
      const style = getComputedStyle(stage);
      const availableWidth = stage.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
      const ratio = side.oriented.width / side.oriented.height;
      let width = availableWidth;
      let height = width / ratio;
      if (height > 340) {
        height = 340;
        width = height * ratio;
      }
      const frame = side.box.parentElement as HTMLElement;
      frame.style.width = `${Math.round(width)}px`;
      frame.style.height = `${Math.round(height)}px`;
      side.canvas.style.width = "100%";
      side.canvas.style.height = "100%";
    }

    function renderSide(side: Side) {
      if (!side.image) return;
      side.oriented = orientedCanvas(side.image, side.rotation, side.angle, side.flipped);
      side.canvas.width = side.oriented.width;
      side.canvas.height = side.oriented.height;
      side.canvas.getContext("2d")!.drawImage(side.oriented, 0, 0);
      fitFrame(side);
      paintCrop(side);
      const suffix = side.flipped ? " · flipped" : "";
      const straighten = Math.abs(side.angle) >= 0.05 ? ` · ${side.angle.toFixed(1)}° straighten` : "";
      side.dimsLabel.textContent = `${side.oriented.width} × ${side.oriented.height} px · ${side.rotation}°${suffix}${straighten}`;
    }

    function paintCrop(side: Side) {
      const crop = side.crop;
      side.box.style.left = `${crop.x * 100}%`;
      side.box.style.top = `${crop.y * 100}%`;
      side.box.style.width = `${crop.w * 100}%`;
      side.box.style.height = `${crop.h * 100}%`;
    }

    function applyDrag(start: Crop, handle: Handle, dx: number, dy: number): Crop {
      if (handle === "move") {
        return {
          x: clamp(start.x + dx, 0, 1 - start.w),
          y: clamp(start.y + dy, 0, 1 - start.h),
          w: start.w,
          h: start.h,
        };
      }
      let { x, y, w, h } = start;
      const right = start.x + start.w;
      const bottom = start.y + start.h;
      if (handle.includes("w")) {
        x = clamp(start.x + dx, 0, right - minCrop);
        w = right - x;
      }
      if (handle.includes("e")) {
        w = clamp(start.w + dx, minCrop, 1 - start.x);
      }
      if (handle.includes("n")) {
        y = clamp(start.y + dy, 0, bottom - minCrop);
        h = bottom - y;
      }
      if (handle.includes("s")) {
        h = clamp(start.h + dy, minCrop, 1 - start.y);
      }
      return { x, y, w, h };
    }

    function startDrag(side: Side, event: PointerEvent) {
      if (!side.image) return;
      event.preventDefault();
      const handle = ((event.target as HTMLElement).dataset.handle || "move") as Handle;
      const frame = side.box.parentElement!;
      const rect = frame.getBoundingClientRect();
      const startX = event.clientX;
      const startY = event.clientY;
      const start = { ...side.crop };
      side.box.focus({ preventScroll: true });
      side.box.setPointerCapture(event.pointerId);

      const move = (moveEvent: PointerEvent) => {
        const dx = (moveEvent.clientX - startX) / rect.width;
        const dy = (moveEvent.clientY - startY) / rect.height;
        side.crop = applyDrag(start, handle, dx, dy);
        paintCrop(side);
      };
      const end = () => {
        side.box.removeEventListener("pointermove", move);
        side.box.removeEventListener("pointerup", end);
        side.box.removeEventListener("pointercancel", end);
        scheduleCompose();
      };
      side.box.addEventListener("pointermove", move);
      side.box.addEventListener("pointerup", end);
      side.box.addEventListener("pointercancel", end);
    }

    function rotateSide(side: Side, direction: 1 | -1) {
      if (!side.image) return;
      const crop = side.crop;
      if (direction === 1) {
        side.crop = { x: 1 - (crop.y + crop.h), y: crop.x, w: crop.h, h: crop.w };
        side.rotation = (side.rotation + 90) % 360;
      } else {
        side.crop = { x: crop.y, y: 1 - (crop.x + crop.w), w: crop.h, h: crop.w };
        side.rotation = (side.rotation + 270) % 360;
      }
      renderSide(side);
      scheduleCompose();
    }

    function flipSide(side: Side) {
      if (!side.image) return;
      side.crop = { ...side.crop, x: 1 - side.crop.x - side.crop.w };
      side.flipped = !side.flipped;
      renderSide(side);
      scheduleCompose();
    }

    function resetCrop(side: Side) {
      if (!side.image) return;
      side.crop = { x: 0, y: 0, w: 1, h: 1 };
      paintCrop(side);
      scheduleCompose();
    }

    async function loadSide(side: Side, file: File | undefined) {
      if (!file) return;
      if (!allowedTypes.has(file.type)) {
        showStatus("Choose a JPG, PNG, or WebP image.", true);
        return;
      }
      if (file.size > maxFileBytes) {
        showStatus("Choose an image smaller than 10 MB.", true);
        return;
      }
      showStatus(`Reading the ${side.key} side…`);
      try {
        const image = await loadImage(file);
        side.image = image;
        side.rotation = 0;
        side.angle = 0;
        side.flipped = false;
        side.crop = { x: 0, y: 0, w: 1, h: 1 };
        side.angleSlider.value = "0";
        side.angleValue.textContent = "0.0°";
        side.nameLabel.textContent = file.name;
        side.drop.hidden = true;
        side.editor.hidden = false;
        side.replace.hidden = false;
        renderSide(side);
        hideStatus();
        combineButton.disabled = false;
        scheduleCompose();
      } catch (error) {
        showStatus(error instanceof Error ? error.message : "That image could not be read.", true);
      } finally {
        side.input.value = "";
      }
    }

    function initSide(side: Side) {
      side.input.addEventListener("change", () => loadSide(side, side.input.files?.[0]));
      side.replace.addEventListener("click", () => side.input.click());
      side.box.addEventListener("pointerdown", (event) => startDrag(side, event));
      let angleFrame = 0;
      side.angleSlider.addEventListener("input", () => {
        side.angle = Number(side.angleSlider.value);
        side.angleValue.textContent = `${side.angle.toFixed(1)}°`;
        if (angleFrame) return;
        angleFrame = requestAnimationFrame(() => {
          angleFrame = 0;
          if (!side.image) return;
          renderSide(side);
          scheduleCompose();
        });
      });
      side.box.addEventListener("keydown", (event) => {
        if (!side.image) return;
        const step = event.shiftKey ? 0.02 : 0.005;
        const crop = side.crop;
        let x = crop.x;
        let y = crop.y;
        if (event.key === "ArrowLeft") x -= step;
        else if (event.key === "ArrowRight") x += step;
        else if (event.key === "ArrowUp") y -= step;
        else if (event.key === "ArrowDown") y += step;
        else return;
        event.preventDefault();
        side.crop = { ...crop, x: clamp(x, 0, 1 - crop.w), y: clamp(y, 0, 1 - crop.h) };
        paintCrop(side);
        scheduleCompose();
      });
      const actions: Record<string, () => void> = {
        auto: () => autoCrop(side),
        left: () => rotateSide(side, -1),
        right: () => rotateSide(side, 1),
        flip: () => flipSide(side),
        reset: () => resetCrop(side),
      };
      side.root.querySelectorAll<HTMLButtonElement>("[data-action]").forEach((button) => {
        button.addEventListener("click", () => actions[button.dataset.action || ""]?.());
      });

      ["dragenter", "dragover"].forEach((eventName) => side.drop.addEventListener(eventName, (event) => {
        event.preventDefault();
        side.drop.classList.add("is-dragging");
      }));
      ["dragleave", "drop"].forEach((eventName) => side.drop.addEventListener(eventName, (event) => {
        event.preventDefault();
        side.drop.classList.remove("is-dragging");
      }));
      side.drop.addEventListener("drop", (event) => loadSide(side, event.dataTransfer?.files[0]));
    }

    function croppedSideCanvas(side: Side, maxWidth = 2400) {
      const source = side.oriented!;
      const crop = side.crop;
      const sx = Math.round(crop.x * source.width);
      const sy = Math.round(crop.y * source.height);
      const sw = Math.max(1, Math.round(crop.w * source.width));
      const sh = Math.max(1, Math.round(crop.h * source.height));
      const scale = Math.min(1, maxWidth / sw);
      const canvas = document.createElement("canvas");
      canvas.width = Math.round(sw * scale);
      canvas.height = Math.round(sh * scale);
      const context = canvas.getContext("2d")!;
      context.imageSmoothingEnabled = true;
      context.imageSmoothingQuality = "high";
      context.drawImage(source, sx, sy, sw, sh, 0, 0, canvas.width, canvas.height);
      return canvas;
    }

    function layoutA4(parts: Array<{ width: number; height: number }>) {
      const cardWidth = a4.width - a4.margin * 2;
      let heights = parts.map((part) => cardWidth * part.height / part.width);
      const gap = a4.gap;
      const maxGroup = a4.height - a4.minVertical * 2;
      let total = heights.reduce((sum, height) => sum + height, 0) + gap * Math.max(0, parts.length - 1);
      let scale = 1;
      if (total > maxGroup && parts.length) {
        const available = maxGroup - gap * (parts.length - 1);
        const natural = heights.reduce((sum, height) => sum + height, 0);
        scale = available / natural;
        heights = heights.map((height) => height * scale);
        total = available + gap * (parts.length - 1);
      }
      const width = cardWidth * scale;
      const x = (a4.width - width) / 2;
      let y = (a4.height - total) / 2;
      const items = heights.map((height) => {
        const item = { x, y, width, height };
        y += height + gap;
        return item;
      });
      return { width: a4.width, height: a4.height, items };
    }

    function pageCanvas(parts: HTMLCanvasElement[]) {
      const layout = layoutA4(parts.map((canvas) => ({ width: canvas.width, height: canvas.height })));
      const scale = previewWidth / layout.width;
      const canvas = document.createElement("canvas");
      canvas.width = previewWidth;
      canvas.height = Math.round(layout.height * scale);
      const context = canvas.getContext("2d")!;
      context.fillStyle = "#ffffff";
      context.fillRect(0, 0, canvas.width, canvas.height);
      context.imageSmoothingEnabled = true;
      context.imageSmoothingQuality = "high";
      layout.items.forEach((item, index) => {
        context.drawImage(parts[index], item.x * scale, item.y * scale, item.width * scale, item.height * scale);
      });
      return canvas;
    }

    function canvasBlob(canvas: HTMLCanvasElement, quality: number) {
      return new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, "image/jpeg", quality));
    }

    async function jpegBlob(canvas: HTMLCanvasElement) {
      let quality = 0.92;
      let blob = await canvasBlob(canvas, quality);
      while (blob && blob.size > 4 * 1024 * 1024 && quality > 0.6) {
        quality -= 0.08;
        blob = await canvasBlob(canvas, quality);
      }
      return blob;
    }

    function clearOutput() {
      if (outputUrl) URL.revokeObjectURL(outputUrl);
      outputUrl = "";
      outputVisible = false;
      preview.removeAttribute("src");
      outputPanel.hidden = true;
    }

    function activeSides() {
      return (["front", "back"] as SideKey[]).map((key) => sides[key]).filter((side) => side.image && side.oriented);
    }

    async function compose(showSheet = false) {
      const active = activeSides();
      if (!active.length) {
        composeSequence++;
        clearOutput();
        return false;
      }
      const sequence = ++composeSequence;
      const canvas = pageCanvas(active.map((side) => croppedSideCanvas(side)));
      const blob = await jpegBlob(canvas);
      if (!blob || sequence !== composeSequence) return false;
      if (outputUrl) URL.revokeObjectURL(outputUrl);
      outputUrl = URL.createObjectURL(blob);
      preview.src = outputUrl;
      preview.alt = `A4 NID sheet preview: ${active.map((side) => side.key).join(" and ")} ${active.length > 1 ? "sides" : "side"}`;
      downloadLink.href = outputUrl;
      downloadLink.download = `nid-${active.map((side) => side.key).join("-")}-a4.jpg`;
      outputDims.textContent = `${canvas.width} × ${canvas.height} px`;
      outputSize.textContent = `${Math.round(blob.size / 1024)} KB`;
      outputCopy.textContent = active.length === 2
        ? "White A4 page with the front above the back and a 12 mm gap."
        : `White A4 page with only the ${active[0].key} side. Add the other side for a complete NID.`;
      if (showSheet) outputPanel.hidden = false;
      return true;
    }

    async function combine() {
      if (!activeSides().length) {
        showStatus("Add the front or back image first.", true);
        return;
      }
      hideStatus();
      combineButton.disabled = true;
      const built = await compose(true);
      combineButton.disabled = false;
      if (!built) {
        showStatus("The sheet could not be built. Try another image.", true);
        return;
      }
      outputVisible = true;
      outputPanel.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function downloadPdfFile() {
      const active = activeSides();
      if (!active.length) return;
      const parts = active.map((side) => croppedSideCanvas(side));
      const layout = layoutA4(parts.map((part) => ({ width: part.width, height: part.height })));
      const pdf = new jsPDF({ orientation: "portrait", unit: "mm", format: "a4" });
      layout.items.forEach((item, index) => {
        const data = parts[index].toDataURL("image/jpeg", 0.92);
        pdf.addImage(data, "JPEG", item.x, item.y, item.width, item.height);
      });
      pdf.save(`nid-${active.map((side) => side.key).join("-")}-a4.pdf`);
    }

    function scheduleCompose() {
      if (!outputVisible) return;
      clearTimeout(composeTimer);
      composeTimer = window.setTimeout(() => { void compose(); }, 80);
    }

    Object.values(sides).forEach(initSide);
    window.addEventListener("resize", () => Object.values(sides).forEach(fitFrame));
    combineButton.addEventListener("click", () => { void combine(); });
    downloadPdf.addEventListener("click", downloadPdfFile);
  </script>
</Base>
