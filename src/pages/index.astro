---
import Base from "../layouts/Base.astro";
---

<Base>
  <!-- NAV -->
  <header class="nav">
    <div class="container nav-inner">
      <a class="brand" href="#top"><span class="brand-mark">M</span> Mutation Automation</a>
      <nav class="nav-links">
        <a href="#product">Product</a>
        <a href="#bugs">Bug map</a>
        <a href="#how">How it works</a>
        <a href="#experience">Experience</a>
        <a href="#contact">Contact</a>
      </nav>
      <div style="display:flex;gap:8px;align-items:center">
        <a class="btn btn-sm-glass" href="#contact">Talk to us</a>
        <a class="btn btn-filled" href="#contact">Automate mutation →</a>
      </div>
    </div>
  </header>

  <!-- HERO -->
  <div class="hero" id="top">
    <div class="hero-grid-bg"></div>
    <div class="container hero-copy">
      <span class="badge"><span class="dot"></span> Built for mutation.land.gov.bd <span class="badge-text">· v3 live</span></span>
      <h1 class="display-xl" style="margin-top:20px">Mutation filing,<br />automated end-to-end.</h1>
      <p class="body-xl hero-sub">Five years inside land.gov.bd — every timeout, OTP failure, and NID mismatch. We built the automation that knows every bug and the way around it.</p>
      <div class="hero-ctas">
        <a class="btn btn-filled btn-lg" href="#contact">Start automating →</a>
        <a class="btn btn-glass" href="#bugs">See the bug map</a>
      </div>
      <div class="hero-meta code">
        <span>✓ namjari abedon auto-fill</span>
        <span>✓ khatian + dag auto-check</span>
        <span>✓ payment + shunani tracking</span>
      </div>

      <!-- product shot -->
      <div class="shot-wrap">
        <div class="shot-glow"></div>
        <div class="terminal">
          <div class="term-bar">
            <span class="term-dot"></span><span class="term-dot"></span><span class="term-dot"></span>
            <span class="term-url code">mutation.land.gov.bd › নামজারি আবেদন › #MUT-2026-08431</span>
            <span style="margin-left:auto" class="pill pill-ok">● live run</span>
          </div>
          <div class="term-body">
            <div class="term-left">
              <div style="display:flex;justify-content:space-between;align-items:center">
                <b style="color:var(--ink)">আবেদন অগ্রগতি</b>
                <span class="pill pill-warn code">78% · শুনানি pending</span>
              </div>
              <div class="kv"><span>আবেদন নম্বর</span><b class="code" style="color:var(--ink)">MUT-2026-08431</b></div>
              <div class="kv"><span>খতিয়ান / দাগ</span><b class="code" style="color:var(--ink)">K‑4412 · Dag 1187</b></div>
              <div class="kv"><span>NID verification</span><span class="pill pill-ok">passed · retry 1</span></div>
              <div class="kv"><span>Server session</span><span class="pill pill-ok">kept alive · 4h 12m</span></div>
              <div class="kv"><span>Payment (Ekpay)</span><span class="pill pill-ok">৳70 paid ✓</span></div>
              <div class="progress"><div></div></div>
              <p class="body-md muted" style="margin:12px 0 0">Auto-retries on 502 / session expiry. No manual re-login at 2am.</p>
            </div>
            <div class="term-right">
              <div class="code" style="color:var(--faint);font-size:11px;letter-spacing:.08em">AUTOMATION LOG — today</div>
              <pre class="log" style="margin:10px 0 0;white-space:pre-wrap">→ form fill <span class="dim">abedon‑01 … 14 fields</span> <span class="ok">✓ 3.1s</span>
→ nid check <span class="dim">EC verify</span> <span class="ok">✓</span>
→ khatian fetch <span class="dim">502 → retry →</span> <span class="ok">✓ 9.4s</span>
→ otp listener <span class="dim">waiting sms…</span> <span class="ok">captured</span>
→ payment <span class="dim">ekpay callback lag</span> <span class="ok">✓ confirmed</span>
→ shunani date <span class="dim">scraped + sms alert</span> <span class="ok">✓ Oct 28</span>
<span class="dim">— session kept alive, 0 manual logins —</span></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- STRIP -->
  <div class="strip">
    <div class="container strip-row code">
      <span>5+ YEARS ON LAND.GOV.BD</span><span>·</span>
      <span>12,000+ MUTATIONS FILED</span><span>·</span>
      <span>40+ BUGS MAPPED</span><span>·</span>
      <span>99.2% FILING SUCCESS</span><span>·</span>
      <span>নামজারি · খারিজ · e‑পর্চা</span>
    </div>
  </div>

  <!-- STATS / EXPERIENCE -->
  <section id="experience">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Why us — 5 years in the trenches</div>
        <h2 class="display-md">We don't guess. We've filed through every outage.</h2>
        <p class="body-lg">Anyone can script a form. We know what the portal does at 11:58pm before maintenance, how NID names fail on a hyphen, and which retry actually gets your khatian to load.</p>
      </div>
      <div class="stats">
        <div class="card stat"><b>5 yrs</b><span>Daily hands-on with mutation.land.gov.bd since 2021 — abedon to DCR.</span></div>
        <div class="card stat"><b>12k+</b><span>Namjari applications filed, tracked to shunani and khatian print.</span></div>
        <div class="card stat"><b>40+</b><span>Documented portal bugs with tested workarounds, updated weekly.</span></div>
        <div class="card stat"><b>99.2%</b><span>First-pass filing success vs ~70% manual average on bad days.</span></div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section id="product" style="padding-top:0">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Product</div>
        <h2 class="display-md">Everything between login and DCR, handled.</h2>
        <p class="body-lg">One pipeline that fills, verifies, pays, and watches your case — with human fallback when the portal misbehaves.</p>
      </div>
      <div class="grid-3">
        <div class="card"><div class="icon">◈</div><h3>Auto abedon fill</h3><p>Applicant, seller, schedule, tafsir — mapped from your Excel / PDF deed to every portal field. Bangla + English handled.</p></div>
        <div class="card"><div class="icon">◎</div><h3>NID + mobile verify</h3><p>EC NID check, OTP listener, name-mismatch normalizer. Retries the exact sequence the portal expects.</p></div>
        <div class="card"><div class="icon">▦</div><h3>Khatian / dag check</h3><p>Pulls e‑porcha, validates dag vs mouza, flags RS/SA mismatch before you pay a single taka.</p></div>
        <div class="card"><div class="icon">⬣</div><h3>Payment + receipts</h3><p>Ekpay / Sonali flow with callback polling. Receipts archived per case, ready for AC Land office.</p></div>
        <div class="card"><div class="icon">◐</div><h3>Shunani tracking</h3><p>Hearing date scraper + SMS/WhatsApp alerts. Auto-checks order sheet for approval or correction.</p></div>
        <div class="card"><div class="icon">⬢</div><h3>Session survival</h3><p>Keep-alive, auto re-login, 502 backoff, maintenance-window pausing. Runs overnight without dying.</p></div>
      </div>
    </div>
  </section>

  <!-- BUG MAP -->
  <section id="bugs" style="padding-top:0">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">The bug map — our moat</div>
        <h2 class="display-md">Every land.gov.bd bug, with a way around.</h2>
        <p class="body-lg">This is what 5 years buys you. A living runbook of portal failures — and the workaround coded into every run.</p>
      </div>
      <div class="bugs">
        <div class="bug-row head"><div>Portal bug (you've seen it)</div><div>Our workaround (coded in)</div></div>
        <div class="bug-row"><div><b style="color:var(--body)">Session expires mid-form → data wiped</b><br />The #1 killer. 20-minute idle logout on long abedons.</div><div>Keystroke-level keep-alive + draft snapshot every field. Auto re-login and resume exactly where it died.</div></div>
        <div class="bug-row"><div><b style="color:var(--body)">502 on khatian fetch at peak hours</b><br />9am–1pm the record room API just gives up.</div><div>Exponential backoff + off-peak scheduler. Queues fetches for 2–6am window, 3x success rate.</div></div>
        <div class="bug-row"><div><b style="color:var(--body)">NID name mismatch (হ vs হ্, hyphen, dot)</b><br />EC spelling ≠ deed spelling → hard reject.</div><div>Fuzzy Bangla normalizer + alias table from 12k filings. Flags true mismatches before submission.</div></div>
        <div class="bug-row"><div><b style="color:var(--body)">OTP never arrives / arrives twice</b><br />Mobile verification stalls the whole flow.</div><div>Dedicated OTP listener with 90s resend logic. Detects duplicate-OTP trap and picks the valid one.</div></div>
        <div class="bug-row"><div><b style="color:var(--body)">Payment deducted, receipt missing</b><br />Ekpay callback lag shows "unpaid" for hours.</div><div>Callback poller for 24h + transaction-ID reconciliation. Proof packet generated even if portal lags.</div></div>
        <div class="bug-row"><div><b style="color:var(--body)">Wrong shunani date / silent reschedule</b><br />Date changes with no SMS; you miss hearing.</div><div>Daily order-sheet scrape + instant alert. We catch reschedules the portal never tells you about.</div></div>
      </div>
      <p class="body-md muted" style="margin-top:12px">+ 34 more in the private runbook — file-upload size traps, deed-number formats, mouza dropdown desync, DCR print bugs. Updated weekly.</p>
    </div>
  </section>

  <!-- HOW -->
  <section id="how" style="padding-top:0">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">How it works</div>
        <h2 class="display-md">Send deeds. Get hearing dates.</h2>
      </div>
      <div class="steps">
        <div class="card step"><div class="step-num">01</div><h3>Drop your files</h3><p>Deed scans, NIDs, khatian photos via Drive / WhatsApp / dashboard. We parse and validate in minutes.</p></div>
        <div class="card step"><div class="step-num">02</div><h3>Automation files it</h3><p>Pipeline logs in, fills, verifies, pays — routing around every known bug. You watch live in the dashboard.</p></div>
        <div class="card step"><div class="step-num">03</div><h3>You get updates</h3><p>Shunani date, correction notices, approval + DCR — pushed to SMS/WhatsApp. Walk into AC Land only when it counts.</p></div>
      </div>
    </div>
  </section>

  <!-- FOR WHOM -->
  <section style="padding-top:0">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Built for</div>
        <h2 class="heading-md">Lawyers, deed writers, and high-volume offices.</h2>
      </div>
      <div class="grid-3">
        <div class="card"><h3>Advocates & mohuris</h3><p>10–100 cases/month? Bulk upload, per-case status, client-ready receipts. Stop babysitting the portal.</p></div>
        <div class="card"><h3>Housing & developers</h3><p>Plot-by-plot mutation for projects. Dag-level validation catches title issues before registration.</p></div>
        <div class="card"><h3>Service centers</h3><p>Run a namjari help desk? White-label filing with your branding, our bug-proof engine underneath.</p></div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="contact" style="padding-top:0">
    <div class="container">
      <div class="featured">
        <div>
          <h2>Stop fighting land.gov.bd. Let 5 years of workarounds do it.</h2>
          <p>Send one test case — we'll file it and show you the full log. If the portal breaks, you'll see exactly how we route around it.</p>
        </div>
        <div>
          <div class="card" style="background:#0F1011;border-color:rgba(0,0,0,.2)">
            <div class="code" style="font-size:12px;color:var(--muted)">GET STARTED</div>
            <h3 style="margin:8px 0">WhatsApp: 01400133142</h3>
            <p style="margin-bottom:16px">Or email contact@nazariautomation.xyz — reply within 1 business day.</p>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              <a class="btn btn-dark" href="https://wa.me/8801400133142">WhatsApp →</a>
              <a class="btn btn-glass btn-lg" style="height:44px" href="mailto:contact@nazariautomation.xyz">Email us</a>
            </div>
          </div>
        </div>
      </div>
      <p class="body-md muted" style="margin-top:16px;text-align:center">Independent automation service. Not affiliated with the Government of Bangladesh or land.gov.bd.</p>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <div class="container foot-grid">
      <div>
        <a class="brand" href="#top"><span class="brand-mark">M</span> Mutation Automation</a>
        <br /><small>5 years on mutation.land.gov.bd.<br />Every bug known. Every workaround coded.<br />Dhaka, Bangladesh.</small>
      </div>
      <div class="foot-links">
        <a href="#product">Product</a><a href="#bugs">Bug map</a><a href="#how">How it works</a><a href="#contact">Contact</a>
      </div>
    </div>
    <div class="container" style="margin-top:24px"><small style="color:var(--faint);font-size:12px">© 2026 Mutation Automation. নামজারি automation for land.gov.bd.</small></div>
  </footer>
</Base>
